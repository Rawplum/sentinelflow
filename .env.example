# Copy this file to .env, then replace every CHANGE_ME value.
# .env is ignored by Git. Never commit real passwords, tokens, or keys.

APP_NAME=SentinelFlow
APP_ENV=development
DEBUG=false

# Authentication. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value.
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=sentinelflow
JWT_AUDIENCE=sentinelflow-api

# PostgreSQL.
#
# POSTGRES_* are read by compose.yaml. Compose builds its own DATABASE_URL that
# points at the `db` service, so you do not edit it for Docker.
#
# URL-encode special characters in the password (for example, @ becomes %40):
# the same value goes into a URL and into the postgres container.
POSTGRES_DB=sentinelflow
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=CHANGE_ME

# Only used when you run the API directly on your machine (not in Docker):
#   .venv/Scripts/python.exe -m uvicorn sentinelflow.main:app --port 8000
# Inside compose this value is ignored and rewritten to point at `db:5432`.
DATABASE_URL=postgresql+psycopg://sentinelflow:CHANGE_ME@127.0.0.1:5432/sentinelflow

# Host ports for `docker compose up`. Change these if something else already
# listens on 5432 / 8000 / 8080. The console is the only one you open.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080

# AI agent (optional). Leave these unset to disable the agent entirely: the rest
# of the API keeps working and POST /alerts/{id}/investigations returns 503.
# LLM_API_BASE is the OpenAI-compatible base URL, e.g. https://api.openai.com/v1
# Never commit a real API key.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_ROUNDS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_TOOL_TIMEOUT_SECONDS=5
# Hard wall-clock ceiling for one investigation, and the queue lease.
# AGENT_LEASE_SECONDS must be greater than AGENT_MAX_RUNTIME_SECONDS.
AGENT_MAX_RUNTIME_SECONDS=180
AGENT_LEASE_SECONDS=240
AGENT_MAX_ATTEMPTS=2
AGENT_RETRY_BACKOFF_SECONDS=5
# Refuse new investigations when this many are queued or running.
AGENT_MAX_PENDING=50

# Largest accepted request body (bytes). 5242880 = 5 MiB.
MAX_REQUEST_BODY_BYTES=5242880
