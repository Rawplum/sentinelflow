[
  {
    "id": "suspicious_bruteforce",
    "scenario": "suspicious",
    "description": "同一账号同一来源 5 分钟内 5 次失败登录，没有任何成功。",
    "applicable_to": [
      "deterministic",
      "single_shot",
      "agent"
    ],
    "alert": {
      "rule_id": "AUTH-001",
      "severity": "high",
      "username": "alice.demo"
    },
    "events": [
      {
        "offset_minutes": 0,
        "outcome": "failure",
        "raw_message": "failed password for alice.demo"
      },
      {
        "offset_minutes": 1,
        "outcome": "failure",
        "raw_message": "failed password for alice.demo"
      },
      {
        "offset_minutes": 2,
        "outcome": "failure",
        "raw_message": "failed password for alice.demo"
      },
      {
        "offset_minutes": 3,
        "outcome": "failure",
        "raw_message": "failed password for alice.demo"
      },
      {
        "offset_minutes": 4,
        "outcome": "failure",
        "raw_message": "failed password for alice.demo"
      }
    ],
    "expect": {
      "conclusive": true,
      "min_risk": "medium",
      "should_cite": true
    }
  },
